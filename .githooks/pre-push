#!/usr/bin/env bash
# Fail closed: block the push if any tracked file hits the private deny list
# (or the list is missing). Then refuse a branch push RoboRev has not cleared
# (tools/roborev-push-guard.sh), with git's ref lines on its stdin.
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1
refs=$(cat)
git ls-files -z | tools/deny-scan.sh -0 || { echo "pre-push: deny-scan failed; push blocked" >&2; exit 1; }
[ -x tools/roborev-push-guard.sh ] || { echo "pre-push: tools/roborev-push-guard.sh is missing; push blocked" >&2; exit 1; }
printf '%s\n' "$refs" | tools/roborev-push-guard.sh || exit 1
